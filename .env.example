# Tilopay Configuration
TILOPAY_WEBHOOK_SECRET=<your_tilopay_webhook_secret>
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=<your_tilopay_api_key>
TILOPAY_USER=<your_tilopay_api_user>
TILOPAY_PASSWORD=<your_tilopay_api_password>

# Resend Email Configuration
RESEND_API_KEY=<your_resend_api_key>
ORDER_NOTIFICATION_EMAIL=deepsleepp.cr@gmail.com

# Application URL (for Vercel deployment)
APP_URL=https://deepsleep.shopping

# Store availability
# TRUE = accept new orders, FALSE = block checkout and show out-of-stock message
PRODUCT_IN_STOCK=TRUE
OUT_OF_STOCK_MESSAGE=Estamos sin stock por el momento. No estamos recibiendo pedidos nuevos.

# Meta Pixel & Conversions API
# Pixel ID: from Meta Events Manager → Data Sources → your Pixel → Settings
META_PIXEL_ID=1710686599976070
# Access Token: from Meta Events Manager → Settings → Generate access token
META_CAPI_ACCESS_TOKEN=<your_token_here>

# Betsy CRM Integration
BETSY_API_KEY=<your_betsy_api_key>
BETSY_API_URL=https://www.betsycrm.com/api/integration/orders/create

# SINPE Movil (manual payment). The SINPE option only appears when a number is set.
# Also accepted: SINPE_NUMERO / SINPE_PHONE and SINPE_NOMBRE / SINPE_OWNER_NAME
SINPE_NUMBER=<8-digit SINPE number>
SINPE_NAME=<account holder name shown to customers>
# Optional: WhatsApp that receives payment receipts (defaults to 6201-9914)
# SINPE_WHATSAPP=62019914
# Optional: set to FALSE to hide SINPE without removing the number
# SINPE_ENABLED=TRUE
